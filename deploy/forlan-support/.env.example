# The public static IP used by remote Forlan Destek clients.
FORLAN_SUPPORT_HOST=95.70.196.174

# Generate each value separately with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FORLAN_DB_PASSWORD=replace-with-a-random-url-safe-secret
FORLAN_JWT_SECRET=replace-with-a-different-random-url-safe-secret

# First launch only. Use a unique username and a password of at least 16 characters.
# Remove these two values and recreate support-api after the first admin is created.
FORLAN_BOOTSTRAP_ADMIN_USERNAME=admin
FORLAN_BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-starting
FORLAN_TOKEN_TTL_HOURS=12
